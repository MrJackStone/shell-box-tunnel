! TUNNEL_V2_POSTDFLPICS


baseScale = 10
maxLabel  = '%POST_slabDeflectionPathLabel%+'
minLabel  = '%POST_slabDeflectionPathLabel%-'

! Tunnel deflections
TUNNEL_V2_POSTTUNNELDFL

! Inlet slab deflections
*if,GEO_HDW1_status,eq,1,or,GEO_HDW2_status,eq,1,then
  TUNNEL_V2_POSTINLETDFL
*endif

! Approach slab deflections
*if,GEO_APR_status,eq,1,then
  TUNNEL_V2_POSTAPPSLABDFL
*endif
